PROJECT_NAME="Flood Impact Assessment"
VERSION="0.1.0"
API_PREFIX="/api"

# Local SQLite default (or PostgreSQL/PostGIS: postgresql://postgres:postgrespassword@localhost:5432/flood_impact)
DATABASE_URL="sqlite:///./data/flood_impact.db"

# Processing Configuration
DEFAULT_TILE_SIZE=512
DEFAULT_INFERENCE_BATCH_SIZE=4
MAX_UPLOAD_SIZE_MB=500

# Next.js Public API URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
